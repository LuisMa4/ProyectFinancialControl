# Clave de la API de OpenAI (opcional): si la defines aquí, se usa como
# respaldo para cuentas que aún no configuraron su propia API key desde
# el chat. Cada usuario también puede conectar su propia key desde la
# app (se guarda cifrada en el servidor local, nunca en el código).
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
